---
import '../styles/global.css';
interface Props { title: string; description: string; canonical: string; jsonLd?: Record<string,any>; ogImage?: string; ogType?: 'website'|'article'; twitterCard?: 'summary_large_image'|'summary'; noIndex?: boolean; noFollow?: boolean; }
const { title, description, canonical, jsonLd, ogImage='/favicon.svg', ogType='website', twitterCard='summary_large_image', noIndex=false, noFollow=false } = Astro.props;
const siteName='سِياق — مرجع المطور العربي للذكاء الاصطناعي'; const fullTitle=title.includes('سِياق')?title:${title} — ; const siteUrl='https://ai.skakh.com'; const ogImageUrl=new URL(ogImage,siteUrl).href;
---
<!DOCTYPE html><html lang="ar" dir="rtl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="generator" content="Astro"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/><title></title><meta name="description" content=/><meta name="theme-color" content="#4ade80"/><link rel="canonical" href=/><meta name="robots" content=${noIndex?'noindex':'index'},/><meta property="og:type" content=/><meta property="og:url" content=/><meta property="og:title" content=/><meta property="og:description" content=/><meta property="og:image" content=/><meta property="og:site_name" content=/><meta property="og:locale" content="ar_SA"/><meta name="twitter:card" content=/><meta name="twitter:site" content="@siyaq_ai"/><meta name="twitter:creator" content="@khly500"/><meta name="twitter:title" content=/><meta name="twitter:description" content=/><meta name="twitter:image" content=/><link rel="alternate" type="application/rss+xml" title="سِياق - أحدث البرومبتات" href="/rss.xml"/><link rel="sitemap" type="application/xml" href="/sitemap-index.xml"/><link rel="icon" type="image/svg+xml" href="/favicon.svg"/><link rel="apple-touch-icon" href="/favicon.svg"/><link rel="manifest" href="/site.webmanifest"/></head><body><header class="top"><div class="logo"><div class="mark">س</div><a href="/" aria-label="سِياق - الرئيسية">سِياق</a></div><div class="sp"></div><nav class="top-nav" aria-label="التنقل الرئيسي"><a class="lnk" href="/prompts/" aria-label="البرومبتات">🎯 البرومبتات</a><a class="lnk" href="/codes/" aria-label="الأكواد">💻 الأكواد</a><a class="lnk" href="/search/" aria-label="البحث">🔍 بحث</a><a class="lnk" href="https://github.com/khly500/suyaq-reference" target="_blank" rel="noopener" aria-label="GitHub">⭐ GitHub</a></nav></header><main id="main-content" class="app"><slot/></main><footer class="site-footer"><div class="container"><p>تطوير: <span style="color:#e5e7eb;font-weight:bold">Khal!l</span> | <a href="https://skakh.com" target="_blank" rel="noopener">موقع سكاكا سوفت</a> | <a href="mailto:info@skakh.com">info@skakh.com</a></p><p style="margin-top:.5rem;font-size:.85rem;color:var(--dim)">مفتوح المصدر تحت رخصة MIT — <a href="https://github.com/khly500/suyaq-reference">الكود على GitHub</a></p></div></footer><div id="toast" class="toast" role="alert" aria-live="polite"></div><script is:inline>window.showToast=(m)=>{const t=document.getElementById('toast');t.textContent=m;t.className='toast show';clearTimeout(window.toastTimer);window.toastTimer=setTimeout(()=>t.className='toast',2500);};window.copyToClipboard=async(t,m='تم النسخ!')=>{try{await navigator.clipboard.writeText(t);window.showToast?.(m);return true}catch{window.showToast?.('فشل النسخ');return false}};</script><style>.top{height:54px;flex:none;display:flex;align-items:center;gap:1rem;padding:0 1.5rem;border-bottom:1px solid var(--border);background:rgba(9,9,11,.8);backdrop-filter:blur(10px);position:sticky;top:0;z-index:100}.top::after{content:"";position:absolute;inset-inline:0;bottom:-1px;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.35}.logo{display:flex;align-items:center;gap:.625rem;font-weight:700;font-size:1.125rem;letter-spacing:.2px;text-decoration:none;color:var(--tx)}.mark{width:26px;height:26px;border-radius:8px;display:grid;place-items:center;background:linear-gradient(135deg,var(--ac),#1f9d6a);color:#04140c;font-weight:700;font-size:15px}.sp{flex:1}.top-nav{display:flex;align-items:center;gap:.75rem}.lnk{color:var(--mut);text-decoration:none;padding:.375rem .625rem;border-radius:8px;font-size:.9rem;transition:all .15s}.lnk:hover{color:var(--tx);background:var(--p2)}.app{flex:1;min-height:0;display:grid;grid-template-columns:1fr;gap:1.5rem;padding:1.5rem;max-width:1200px;margin:0 auto;width:100%}@media(min-width:960px){.app{grid-template-columns:232px 372px 1fr;padding:2rem}}.site-footer{text-align:center;padding:2rem;margin-top:auto;border-top:1px solid var(--border);color:var(--muted);font-family:var(--sans);font-size:.875rem;direction:rtl}.site-footer a{color:var(--muted)}.site-footer a:hover{color:var(--ac)}</style></body></html>
